# Required to create the first registrar account on startup.
ADMIN_EMAIL=registrar@your-school.edu
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Required when NODE_ENV=production. Use a long random secret.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional local settings
# PORT=3000
# DATA_DIR=./data
